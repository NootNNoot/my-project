<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>

    <material name="green_dark">
        <color rgba="0 0.4 0 1"/>
    </material>

    <material name="green_light">
        <color rgba="0 0.6 0 1"/>
    </material>

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${ (m/12) * (y*y + z*z) }" ixy="0" ixz="0" 
                     iyy="${ (m/12) * (x*x + z*z) }" iyz="0" 
                     izz="${ (m/12) * (y*y + x * x) }" />
        </inertial>
    </xacro:macro>

    <!-- <xacro:macro name="cylinder_y_inertia" params="m l o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${ (m / 12) * (l*l) }" ixy="0" ixz="0" 
                     iyy="1" iyz="0" 
                     izz="${ (m / 12) * (l*l) }" />
        </inertial>
    </xacro:macro> -->

    <xacro:macro name="cylinder_z_inertia" params="m r h o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${ (m / 12) * (3*r*r + h*h) }" ixy="0" ixz="0" 
                     iyy="${ (m / 12) * (3*r*r + h*h) }" iyz="0" 
                     izz="${ (m / 2) * (r*r) }" />
        </inertial>
    </xacro:macro>


</robot>