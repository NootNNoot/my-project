<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="double_pendulum">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import double_pendulum urdf file -->
    <xacro:include filename="$(find arm_description)/urdf/double_pendulum.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="double_pendulum.ros2_control.xacro" />


    <xacro:double_pendulum_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
